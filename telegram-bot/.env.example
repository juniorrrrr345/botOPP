# Configuration du Bot Telegram LANATION
# Copiez ce fichier vers .env et remplissez vos valeurs

# Token du bot Telegram (obtenu via @BotFather)
BOT_TOKEN=7135151237:YOUR_BOT_TOKEN_HERE

# ID Telegram de l'administrateur principal
ADMIN_ID=8346344099

# URL de connexion MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&appName=appname

# Configuration optionnelle
PORT=3014
USE_WEBHOOK=false
RENDER=false